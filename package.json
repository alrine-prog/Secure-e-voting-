    "start": "node server.js",
    "prisma": "prisma",
    "frontend": "cd frontend && npm run dev"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "bcrypt": true
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@sendgrid/mail": "^8.1.3",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.x",
    "cors": "^2.8.5",
    "csv-parse": "^5.3.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.x",
    "nodemailer": "^6.9.3",
    "pino": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.2.2"
