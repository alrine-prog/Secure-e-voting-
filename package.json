{
  "name": "secure-e-voting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "install-deps": "npm install && npm install --prefix frontend",
    "build": "npm run install-deps && npm run build --prefix frontend",
    "postbuild": "npx prisma db push",
    "start": "node dist/server.js",
    "prisma": "prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "bcrypt": true
  },
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "@sendgrid/mail": "^8.1.3",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.3.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "next": "^14.0.0",
    "node-fetch": "^3.0.0",
    "nodemailer": "^6.9.3",
    "pino": "^9.0.0",
    "rate-limit-redis": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.2.2",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.21.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
