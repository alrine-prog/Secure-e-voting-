// Prisma schema for core models
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id           String   @id @default(uuid())
  name         String
  country      String
  districtCity String
  status       String   @default("pending") // pending | approved | rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  voters       Voter[]
  elections    Election[]
}

model User {
  id           String   @id @default(uuid())
  university   University? @relation(fields: [universityId], references: [id])
  universityId String?
  role         String
  username     String   @unique
  firstName    String
  secondName   String
  email        String   @unique
  phone        String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Voter {
  id                       String   @id @default(uuid())
  university               University @relation(fields: [universityId], references: [id])
  universityId             String
  registeredByUserId       String
  studentRegistrationNumber String?
  nationalId               String?
  firstName                String
  secondName               String
  email                    String?
  phone                    String?
  faculty                  String?
  college                  String?
  yearOfStudy              Int?
  approved                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Election {
  id           String   @id @default(uuid())
  university   University @relation(fields: [universityId], references: [id])
  universityId String
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  status       String   @default("draft")
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VoteToken {
  id         String   @id @default(uuid())
  voterId    String
  electionId String
  tokenHash  String   @unique
  used       Boolean  @default(false)
  issuedAt   DateTime @default(now())
  usedAt     DateTime?
}

model Vote {
  id         String   @id @default(uuid())
  electionId String
  candidate  String
  tokenHash  String
  createdAt  DateTime @default(now())
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  channel   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  details      Json?
  ip           String?
  createdAt    DateTime @default(now())
}
