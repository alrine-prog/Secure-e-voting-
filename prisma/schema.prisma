generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  system_owner
  university_admin
  staff
  voter
}

enum UniversityStatus {
  pending
  approved
  rejected
}

enum ElectionStatus {
  draft
  open
  closed
  archived
}

model University {
  id           String           @id @default(uuid())
  name         String
  country      String
  districtCity String
  status       UniversityStatus @default(pending)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        User[]
  voters       Voter[]
  elections    Election[]
}

model User {
  id            String      @id @default(uuid())
  university    University? @relation(fields: [universityId], references: [id])
  universityId  String?
  role          UserRole    @default(voter)
  username      String      @unique
  firstName     String
  secondName    String
  email         String      @unique
  phone         String?
  passwordHash  String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  emailVerified Boolean     @default(false)

  registeredVoters Voter[]    @relation("RegisteredBy")
  createdElections Election[] @relation("CreatedBy")
}

model Voter {
  id                        String     @id @default(uuid())
  university                University @relation(fields: [universityId], references: [id])
  universityId              String
  registeredByUserId        String
  registeredById            String?
  registeredBy              User?      @relation("RegisteredBy", fields: [registeredById], references: [id], onDelete: Cascade)
  studentRegistrationNumber String?
  nationalId                String?
  firstName                 String
  secondName                String
  email                     String?
  phone                     String?
  faculty                   String?
  college                   String?
  yearOfStudy               Int?
  approved                  Boolean    @default(false)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
}

model Election {
  id            String         @id @default(uuid())
  university    University     @relation(fields: [universityId], references: [id])
  universityId  String
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  status        ElectionStatus @default(draft)
  createdBy     String
  createdById   String?
  createdByUser User?          @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
