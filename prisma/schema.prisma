generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  system_owner
  university_admin
  staff
  voter
}

enum UniversityStatus {
  pending
  approved
  rejected
}

enum ElectionStatus {
  draft
  open
  closed
  archived
}

// ==========================================
// MODELS
// ==========================================

model University {
  id           String           @id @default(uuid())
  name         String
  country      String
  districtCity String
  status       UniversityStatus @default(pending)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  users        User[]           @relation("UniversityUsers")
  voters       Voter[]
  elections    Election[]

  @@index([status])
}

model User {
  id            String      @id @default(uuid())
  university    University? @relation("UniversityUsers", fields: [universityId], references: [id])
  universityId  String?
  role          UserRole    @default(voter)
  username      String      @unique
  firstName     String
  secondName    String
  email         String      @unique
  phone         String?
  passwordHash  String
  isActive      Boolean     @default(true)
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  registeredVoters Voter[]    @relation("RegisteredBy")
  createdElections Election[] @relation("CreatedBy")
}

model Voter {
  id                        String    @id @default(uuid())
  university                University @relation(fields: [universityId], references: [id])
  universityId              String
  registeredByUserId        String
  registeredBy              User      @relation("RegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Cascade)
  studentRegistrationNumber String?
  nationalId                String?
  firstName                 String
  secondName                String
  email                     String?
  phone                     String?
  faculty                   String?
  college                   String?
  yearOfStudy               Int?
  approved                  Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  voteTokens VoteToken[]

  @@unique([universityId, studentRegistrationNumber], map: "uniq_university_student_reg")
  @@index([universityId])
}

model Election {
  id           String         @id @default(uuid())
  university   University     @relation(fields: [universityId], references: [id])
  universityId String
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  status       ElectionStatus @default(draft)
  createdById  String
  createdBy    User           @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  voteTokens   VoteToken[]
  votes        Vote[]

  @@index([universityId, status])
}

model VoteToken {
  id         String   @id @default(uuid())
  voter      Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  voterId    String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electionId String
  tokenHash  String   @unique
  used       Boolean  @default(false)
  issuedAt   DateTime @default(now())
  usedAt     DateTime?

  @@index([voterId, electionId])
}

model Vote {
  id         String   @id @default(uuid())
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electionId String
  candidate  String
  tokenHash  String
  createdAt  DateTime @default(now())

  @@index([electionId])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  channel   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  details      Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([userId])
}
