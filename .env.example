# Environment example

PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_evoting
# Generate a long random secret; do not use this example value in a real deployment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=8h

# Required only when bootstrapping the first system-owner account.
# Login uses this email and password at /login?role=system_owner.
SYSTEM_OWNER_EMAIL=system-owner@example.edu
SYSTEM_OWNER_PASSWORD=replace_with_a_unique_12_plus_character_password
FRONTEND_URL=http://localhost:3000
RECAPTCHA_SECRET=your-secret-key
RECAPTCHA_THRESHOLD=0.5
REDIS_URL=redis://...

# SMTP config (recommended for credential delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.edu

# SendGrid alternative
SENDGRID_API_KEY=

# Twilio config
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional initial university/admin
INITIAL_UNIVERSITY_NAME=
INITIAL_UNIVERSITY_COUNTRY=
INITIAL_UNIVERSITY_CITY=
INITIAL_UNIVERSITY_APPROVE=false
INITIAL_UNIVERSITY_ADMIN_EMAIL=
INITIAL_UNIVERSITY_ADMIN_PASSWORD=
INITIAL_UNIVERSITY_ADMIN_USERNAME=
